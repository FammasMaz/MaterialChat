<?xml version="1.0" encoding="utf-8"?>
<!--
  MaterialChat launcher foreground: the assistant pill as a speech bubble.
  Source of truth: docs/icon/ic_launcher.svg (re-render with docs/icon/render.sh).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 75% scale keeps the content inside the adaptive-icon safe zone (centre 66 of 108). -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.75"
        android:scaleY="0.75">

        <!-- Near-black capsule pill with a speech-bubble tail (same surface as the assistant pill). -->
        <path
            android:fillColor="#1C1B1F"
            android:pathData="M34,34 H74 A20,20 0 0 1 74,74 H48 L30,92 L34,74 A20,20 0 0 1 34,34 Z" />

        <!-- Three waveform bars, the pill's live listening glyph. -->
        <path
            android:fillColor="#D0BCFF"
            android:pathData="M38,51 a4,4 0 0 1 8,0 v6 a4,4 0 0 1 -8,0 z M50,45 a4,4 0 0 1 8,0 v18 a4,4 0 0 1 -8,0 z M62,49 a4,4 0 0 1 8,0 v10 a4,4 0 0 1 -8,0 z" />
    </group>
</vector>
